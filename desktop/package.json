{
  "name": "webforx-time-tracker-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Secure desktop wrapper for Web Forx Time Tracker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "validate": "node --check main.js && node --check preload.js && node --check security.js && npm test",
    "package:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.webforx.timetracker",
    "productName": "Web Forx Time Tracker",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "security.js",
      "assets/**/*",
      "renderer/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": ["dmg", "zip"]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
