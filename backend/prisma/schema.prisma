// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  billing_email String?
  plan          String   @default("free") // free, pro, enterprise
  status        String   @default("active") // active, suspended, archived
  settings      Json     @default("{}")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  users             User[]
  roles             Role[]
  projects          Project[]
  time_entries      TimeEntry[]
  active_timers     ActiveTimer[]
  timer_correction_requests TimerCorrectionRequest[]
  notifications     Notification[]
  audit_logs        AuditLog[]
  auth_events       AuthEvent[]
  integrations      Integration[]
  webhooks          WebhookSubscription[]
  templates         ProjectTemplate[]
  scheduled_reports ScheduledReport[]
  invoices          Invoice[]
  tags              Tag[]
  timer_policies    TimerPolicyConfig[]
  report_caches     ReportCache[]
  access_requests   AccessRequest[]
  payroll_periods   PayrollPeriod[]
  branding_config   BrandingConfig?
  leave_requests    LeaveRequest[]

  @@index([status, created_at])
}

model User {
  id            String   @id @default(uuid())
  email         String
  password_hash String
  first_name    String
  last_name     String
  team_name     String?
  role          Role     @relation(fields: [role_id], references: [id])
  role_id       String
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  is_active     Boolean  @default(true)
  hourly_rate   Decimal? @default(0.00) @db.Decimal(10, 2)
  oidc_provider String?
  oidc_issuer   String?
  oidc_subject  String?
  last_login_provider String?
  mfa_secret    String?
  mfa_enabled   Boolean  @default(false)
  password_changed_at DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  weekly_hour_limit Int?

  project_members       ProjectMember[]
  time_entries          TimeEntry[]
  active_timers         ActiveTimer[]
  notifications         Notification[]
  audit_logs            AuditLog[]
  timer_correction_requests TimerCorrectionRequest[]
  auth_events           AuthEvent[]
  calendar_connection   CalendarConnection?
  password_reset_tokens PasswordResetToken[]
  invoices              Invoice[]
  project_templates     ProjectTemplate[]
  scheduled_reports     ScheduledReport[]
  locked_payroll_periods PayrollPeriod[] @relation("PayrollPeriodLocker")
  leave_requests            LeaveRequest[]
  reviewed_leave_requests   LeaveRequest[] @relation("LeaveReviewer")
  leave_history_actions     LeaveRequestHistory[] @relation("LeaveHistoryActor")

  @@unique([email, organization_id])
  @@index([organization_id, is_active])
  @@index([organization_id, role_id])
  @@index([team_name])
}

model Role {
  id          String @id @default(uuid())
  name        String
  permissions Json   @default("[]")
  users       User[]
  organization_id String?
  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([name, organization_id])
  @@index([organization_id])
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([is_active, name])
}

model Project {
  id            String   @id @default(uuid())
  name          String
  description   String?
  logo_url      String?
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  is_active     Boolean  @default(true)
  budget_hours  Int?
  budget_amount Decimal? @db.Decimal(10, 2)
  created_at    DateTime @default(now())

  members       ProjectMember[]
  time_entries  TimeEntry[]
  active_timers ActiveTimer[]
  invoices      Invoice[]

  @@unique([name, organization_id])
  @@index([organization_id, is_active])
}

model ProjectMember {
  project_id      String
  user_id         String
  role_in_project String

  project Project @relation(fields: [project_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])

  @@id([project_id, user_id])
}

model TimeEntry {
  id               String   @id @default(uuid())
  user_id          String
  project_id       String?
  organization_id  String
  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  task_description String
  start_time       DateTime
  end_time         DateTime
  duration         Int
  entry_type       String // "timer", "manual", "ai_suggested", "calendar_sync"
  notes            String?
  is_billable      Boolean  @default(true)
  status           String   @default("pending") // "pending", "approved", "rejected"
  stop_reason      String?
  auto_stopped     Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user               User              @relation(fields: [user_id], references: [id])
  project            Project?          @relation(fields: [project_id], references: [id])
  tags               TimeEntryTag[]
  invoice_line_items InvoiceLineItem[]

  @@index([organization_id, user_id, start_time])
  @@index([organization_id, project_id, start_time])
  @@index([organization_id, status, created_at])
}

model ActiveTimer {
  id               String    @id @default(uuid())
  user_id          String    @unique
  project_id       String?
  organization_id  String
  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  task_description String
  start_time       DateTime
  persisted_state  Json      @default("{}")
  last_active_ping DateTime? @default(now())
  last_heartbeat_at DateTime? @default(now())
  last_client_activity_at DateTime?
  client_visibility String?
  client_has_focus Boolean?
  heartbeat_state  Json      @default("{}")
  heartbeat_miss_count Int    @default(0)
  is_paused              Boolean   @default(false)
  pause_reason           String?
  paused_at              DateTime?
  idle_warning_shown_at  DateTime?
  paused_duration_seconds Int       @default(0)

  user    User     @relation(fields: [user_id], references: [id])
  project Project? @relation(fields: [project_id], references: [id])

  @@index([organization_id, user_id])
}

model TimerCorrectionRequest {
  id                         String   @id @default(uuid())
  user_id                    String
  organization_id            String
  organization               Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  timer_session_id           String?
  requested_start_time       DateTime
  requested_end_time         DateTime
  requested_duration_seconds Int
  reason                     String
  work_note                  String?
  status                     String   @default("PENDING")
  reviewed_by                String?
  reviewed_at                DateTime?
  reviewer_note              String?
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@index([organization_id, user_id, status, created_at])
}

model TimerPolicyConfig {
  id                                String   @id @default(uuid())
  scope_type                        String   @default("ORGANIZATION") // "GLOBAL" | "ORGANIZATION"
  scope_id                          String?
  organization_id                   String?
  organization                      Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  heartbeat_interval_seconds         Int      @default(180)
  missed_heartbeat_warning_threshold Int      @default(3)
  missed_heartbeat_pause_threshold   Int      @default(4)
  idle_warning_after_minutes         Int      @default(5)
  idle_pause_after_minutes           Int      @default(10)
  max_session_duration_hours         Decimal  @default(8.0) @db.Decimal(4, 2)
  allow_resume_after_idle_pause      Boolean  @default(true)
  require_note_on_resume_after_minutes Int    @default(30)
  created_by                        String?
  updated_by                        String?
  created_at                        DateTime @default(now())
  updated_at                        DateTime @updatedAt

  @@unique([scope_type, scope_id])
  @@index([organization_id])
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  message    String
  type       String // "reminder" or "alert"
  is_read    Boolean  @default(false)
  read_at    DateTime?
  deleted_at DateTime?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([organization_id, user_id, deleted_at, is_read, created_at])
}

model AuditLog {
  id         String   @id @default(uuid())
  user_id    String
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  action     String
  resource   String
  metadata   Json     @default("{}")
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([organization_id, created_at])
  @@index([organization_id, user_id, created_at])
}

model AuthEvent {
  id         String   @id @default(uuid())
  user_id    String?
  email      String?
  organization_id String?
  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  event_type String
  outcome    String
  reason     String?
  ip_address String?
  user_agent String?
  metadata   Json     @default("{}")
  created_at DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at])
  @@index([user_id, created_at])
  @@index([email, created_at])
  @@index([event_type, outcome, created_at])
}

model Integration {
  id        String  @id @default(uuid())
  type      String  // "taiga" or "mattermost"
  config    String  // Encrypted JSON
  is_active Boolean @default(true)
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([type, organization_id])
  @@index([organization_id])
}

model CalendarConnection {
  id            String   @id @default(uuid())
  user_id       String   @unique
  provider      String   @default("google")
  google_email  String?
  refresh_token String
  scope         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model ReportCache {
  id           String   @id @default(uuid())
  report_type  String
  parameters   Json
  data         Json
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  generated_at DateTime @default(now())
  expires_at   DateTime

  @@index([organization_id, report_type, generated_at])
}

model Tag {
  id         String   @id @default(uuid())
  name       String
  color      String   @default("#6366f1")
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  time_entries TimeEntryTag[]

  @@unique([name, organization_id])
  @@index([organization_id])
}

model TimeEntryTag {
  time_entry_id String
  tag_id        String

  time_entry TimeEntry @relation(fields: [time_entry_id], references: [id], onDelete: Cascade)
  tag        Tag       @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([time_entry_id, tag_id])
}

model Invoice {
  id             String    @id @default(uuid())
  invoice_number String    @unique
  client_name    String
  client_email   String?
  project_id     String?
  user_id        String
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  status         String    @default("draft") // draft, sent, paid
  subtotal       Decimal   @db.Decimal(10, 2)
  tax_rate       Decimal?  @db.Decimal(5, 2)
  total          Decimal   @db.Decimal(10, 2)
  notes          String?
  due_date       DateTime?
  issued_at      DateTime?
  paid_at        DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  project    Project?          @relation(fields: [project_id], references: [id])
  creator    User              @relation(fields: [user_id], references: [id])
  line_items InvoiceLineItem[]

  @@index([organization_id, status, created_at])
}

model InvoiceLineItem {
  id            String  @id @default(uuid())
  invoice_id    String
  time_entry_id String?
  description   String
  hours         Decimal @db.Decimal(10, 2)
  rate          Decimal @db.Decimal(10, 2)
  amount        Decimal @db.Decimal(10, 2)

  invoice    Invoice    @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  time_entry TimeEntry? @relation(fields: [time_entry_id], references: [id])
}

model ProjectTemplate {
  id               String   @id @default(uuid())
  name             String
  description      String?
  default_billable Boolean  @default(true)
  budget_hours     Int?
  budget_amount    Decimal? @db.Decimal(10, 2)
  tag_ids          Json     @default("[]")
  created_by       String
  organization_id  String
  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_at       DateTime @default(now())

  creator User @relation(fields: [created_by], references: [id])

  @@unique([name, organization_id])
  @@index([organization_id])
}

model WebhookSubscription {
  id         String   @id @default(uuid())
  url        String
  events     Json     @default("[]")
  secret     String
  is_active  Boolean  @default(true)
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@index([organization_id, is_active])
}

model ScheduledReport {
  id           String    @id @default(uuid())
  user_id      String
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  frequency    String // weekly, monthly
  day_of_week  Int?
  recipients   Json      @default("[]")
  report_type  String    @default("summary")
  is_active    Boolean   @default(true)
  last_sent_at DateTime?
  created_at   DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([organization_id, is_active])
}

model PayrollPeriod {
  id              String    @id @default(uuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  period_type     String    // "weekly" | "biweekly" | "semimonthly" | "custom"
  start_date      DateTime
  end_date        DateTime
  status          String    @default("open") // "open" | "locked"
  locked_at       DateTime?
  locked_by       String?
  locker          User?     @relation("PayrollPeriodLocker", fields: [locked_by], references: [id])
  unlocked_at     DateTime?
  unlocked_by     String?
  notes           String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@unique([organization_id, start_date, end_date])
  @@index([organization_id, status, start_date])
}

model BrandingConfig {
  id                 String   @id @default(uuid())
  organization_id    String   @unique
  organization       Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  app_name           String?
  logo_url           String?
  favicon_url        String?
  primary_color      String   @default("#4F46E5")
  secondary_color    String   @default("#7C3AED")
  custom_domain      String?
  email_from_name    String?
  email_from_address String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}

model AccessRequest {
  id         String   @id @default(uuid())
  full_name  String
  work_email String
  company    String
  team_size  String
  details    String?
  status     String   @default("pending")
  organization_id String?
  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([organization_id, status, created_at])
}

model LeaveRequest {
  id              String    @id @default(uuid())
  user_id         String
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  leave_type      String    // "annual" | "sick" | "unpaid" | "public_holiday" | "other"
  start_date      DateTime
  end_date        DateTime
  days            Decimal   @db.Decimal(4, 1) // supports half-days (e.g. 0.5)
  reason          String?
  status          String    @default("pending") // "pending" | "approved" | "rejected"
  reviewed_by     String?
  reviewed_at     DateTime?
  reviewer_note   String?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  user     User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reviewer User? @relation("LeaveReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)
  history  LeaveRequestHistory[]

  @@index([organization_id, user_id, start_date])
  @@index([organization_id, status, start_date])
}

model LeaveRequestHistory {
  id               String   @id @default(uuid())
  leave_request_id String
  leave_request    LeaveRequest @relation(fields: [leave_request_id], references: [id], onDelete: Cascade)
  status           String   // "submitted" | "approved" | "rejected" | "cancelled"
  actor_id         String
  actor            User     @relation("LeaveHistoryActor", fields: [actor_id], references: [id], onDelete: Cascade)
  comment          String?
  created_at       DateTime @default(now())

  @@index([leave_request_id, created_at])
}
