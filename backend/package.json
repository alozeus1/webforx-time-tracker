{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "schema:check": "node scripts/schema-drift-check.cjs",
    "cron:check": "node scripts/cron-config-check.cjs",
    "release:preflight": "npm run schema:check && npm run cron:check",
    "release:smoke:login": "node scripts/release-smoke-login.cjs",
    "release:verify:idle": "node scripts/verify-idle-production.cjs",
    "release:verify": "npm run release:preflight && npm run release:smoke:login",
    "release:backfill:secrets": "tsx scripts/backfill-encrypted-secrets.ts",
    "report:preview": "tsx scripts/generate-executive-report-preview.ts",
    "start": "npm run schema:check && node dist/index.js",
    "dev": "npm run schema:check && ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "test": "jest",
    "postinstall": "prisma generate",
    "release:baseline-existing": "prisma migrate resolve --applied 20260401000000_initial_schema",
    "release:migrate": "prisma migrate deploy && npm run release:backfill:secrets",
    "migrate:deploy": "prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "googleapis": "^171.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "otplib": "^13.4.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "resend": "^6.9.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.4.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.3.0",
    "node-cron": "^4.2.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "overrides": {
    "@scure/base": "1.1.7",
    "@noble/hashes": "1.8.0",
    "@otplib/plugin-crypto-noble": {
      "@noble/hashes": "1.8.0"
    }
  }
}
