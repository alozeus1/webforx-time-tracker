VITE_API_URL="http://localhost:5005/api/v1"

# Google "Sign in with Google" (Google Identity Services, ID-token flow).
# Must be the SAME OAuth 2.0 Web application client ID as the backend GOOGLE_CLIENT_ID.
# The button only renders when this is set. Uses non-sensitive identity scopes
# (openid/email/profile) — no Google verification required to publish to production.
# The frontend origin(s) must be listed under "Authorized JavaScript origins" for this client.
VITE_GOOGLE_CLIENT_ID=""

VITE_HEARTBEAT_INTERVAL_MINUTES=3
VITE_IDLE_WARNING_MINUTES=15
VITE_MAX_ACTIVE_TIMER_HOURS=8

# Enhanced activity-aware idle detection — must mirror backend TIMER_ENHANCED_ACTIVITY_DETECTION
# When true, the heartbeat hook sends pings even when the tab is hidden (background tabs).
# Default: false. Set to true to enable ActivityWatch-inspired hidden_connected detection.
VITE_TIMER_ENHANCED_ACTIVITY_DETECTION=false
# Grace window (minutes) for hidden_connected tabs before a local warning is shown in-browser.
# Must match backend HIDDEN_CONNECTED_GRACE_MINUTES.
VITE_HIDDEN_CONNECTED_GRACE_MINUTES=10

# Foundation only. Keep false: offline timer writes are not queued until the backend
# supports idempotency, ordering, revision preconditions, and conflict resolution.
VITE_OFFLINE_TIMER_QUEUE_ENABLED=false
